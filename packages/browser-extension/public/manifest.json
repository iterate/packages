{
  "manifest_version": 3,
  "name": "Iterate",
  "description": "Lend this Chrome to an iterate mind: its agents drive the tabs in the mind's tab group.",
  "version": "0.6.0",
  "minimum_chrome_version": "123",
  "key": "<CHROME_EXTENSION_KEY: scripts/build.ts sets it, or leaves the key out>",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "action": {
    "default_title": "Open Iterate",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "index.html" },
  "permissions": [
    "debugger",
    "declarativeNetRequestWithHostAccess",
    "identity",
    "sidePanel",
    "storage",
    "tabGroups"
  ],
  "optional_host_permissions": ["https://*/*", "wss://*/*"]
}
