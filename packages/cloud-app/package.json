{
  "name": "@iterate-com/cloud-app",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "pnpm routes:check && tsc --noEmit",
    "deploy": "node scripts/app.ts deploy",
    "routes:generate": "node scripts/app.ts generate-route-tree",
    "routes:check": "node scripts/app.ts generate-route-tree --check",
    "page-preview": "vite --config preview/vite.config.ts",
    "page-preview:record": "node preview/record.ts"
  },
  "dependencies": {
    "@iterate-com/cloud": "workspace:*",
    "@iterate-com/ui": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "capnweb": "catalog:",
    "iterate": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
