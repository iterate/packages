{
  "name": "@iterate-com/ui",
  "version": "0.1.0",
  "description": "iterate's React components, built to import from a URL in a no-build page",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/packages.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    "./apps/base-path": "./src/apps/base-path.ts",
    "./apps/document": "./src/apps/document.tsx",
    "./apps/head": "./src/apps/head.ts",
    "./apps/router": "./src/apps/router.tsx",
    "./apps/server": "./src/apps/server.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/context-view/*": "./src/components/context-view/*.tsx",
    "./components/context-view/context-view-search": "./src/components/context-view/context-view-search.ts",
    "./components/repo-ide/repo-ide-search": "./src/components/repo-ide/repo-ide-search.ts",
    "./components/repo-ide/repo-client": "./src/components/repo-ide/repo-client.ts",
    "./components/repo-ide/*": "./src/components/repo-ide/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "imports": {},
    "exports": {
      "./page": "./dist/page.mjs",
      "./live": "./dist/live.mjs",
      "./react": "./dist/react.mjs",
      "./react/jsx-runtime": "./dist/react/jsx-runtime.mjs",
      "./react/compiler-runtime": "./dist/react/compiler-runtime.mjs",
      "./react-dom": "./dist/react-dom.mjs",
      "./react-dom/client": "./dist/react-dom/client.mjs",
      "./components/app-build": "./dist/components/app-build.mjs",
      "./components/app-shell": "./dist/components/app-shell.mjs",
      "./components/code-block": "./dist/components/code-block.mjs",
      "./components/code-editor": "./dist/components/code-editor.mjs",
      "./components/connect-button": "./dist/components/connect-button.mjs",
      "./components/context-view/context-view": "./dist/components/context-view/context-view.mjs",
      "./components/environment-head-content": "./dist/components/environment-head-content.mjs",
      "./components/first-project-redirect": "./dist/components/first-project-redirect.mjs",
      "./components/iterate-logo": "./dist/components/iterate-logo.mjs",
      "./components/log-in-with-iterate": "./dist/components/log-in-with-iterate.mjs",
      "./components/not-recorded": "./dist/components/not-recorded.mjs",
      "./components/posthog": "./dist/components/posthog.mjs",
      "./components/project-app-shell": "./dist/components/project-app-shell.mjs",
      "./components/repo-ide/repo-ide": "./dist/components/repo-ide/repo-ide.mjs",
      "./components/route-defaults": "./dist/components/route-defaults.mjs",
      "./components/standalone-page": "./dist/components/standalone-page.mjs",
      "./components/stream-link": "./dist/components/stream-link.mjs",
      "./components/ui/alert-dialog": "./dist/components/ui/alert-dialog.mjs",
      "./components/ui/avatar": "./dist/components/ui/avatar.mjs",
      "./components/ui/badge": "./dist/components/ui/badge.mjs",
      "./components/ui/breadcrumb": "./dist/components/ui/breadcrumb.mjs",
      "./components/ui/button": "./dist/components/ui/button.mjs",
      "./components/ui/card": "./dist/components/ui/card.mjs",
      "./components/ui/checkbox": "./dist/components/ui/checkbox.mjs",
      "./components/ui/command": "./dist/components/ui/command.mjs",
      "./components/ui/dialog": "./dist/components/ui/dialog.mjs",
      "./components/ui/dropdown-menu": "./dist/components/ui/dropdown-menu.mjs",
      "./components/ui/empty": "./dist/components/ui/empty.mjs",
      "./components/ui/field": "./dist/components/ui/field.mjs",
      "./components/ui/input-group": "./dist/components/ui/input-group.mjs",
      "./components/ui/input": "./dist/components/ui/input.mjs",
      "./components/ui/label": "./dist/components/ui/label.mjs",
      "./components/ui/native-select": "./dist/components/ui/native-select.mjs",
      "./components/ui/select": "./dist/components/ui/select.mjs",
      "./components/ui/separator": "./dist/components/ui/separator.mjs",
      "./components/ui/sheet": "./dist/components/ui/sheet.mjs",
      "./components/ui/sidebar": "./dist/components/ui/sidebar.mjs",
      "./components/ui/skeleton": "./dist/components/ui/skeleton.mjs",
      "./components/ui/sonner": "./dist/components/ui/sonner.mjs",
      "./components/ui/spinner": "./dist/components/ui/spinner.mjs",
      "./components/ui/table": "./dist/components/ui/table.mjs",
      "./components/ui/tabs": "./dist/components/ui/tabs.mjs",
      "./components/ui/textarea": "./dist/components/ui/textarea.mjs",
      "./components/ui/tooltip": "./dist/components/ui/tooltip.mjs",
      "./lib/plain-left-click": "./dist/lib/plain-left-click.mjs",
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsdown && tailwindcss --input src/browser/styles.css --output dist/styles.css --minify",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@fsegurai/codemirror-theme-bundle": "catalog:",
    "@iterate-com/shared": "workspace:*",
    "@pierre/trees": "1.0.0-beta.6",
    "@tailwindcss/cli": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "^1.1.1",
    "cn": "catalog:",
    "codemirror": "catalog:",
    "htm": "3.1.1",
    "iterate": "workspace:*",
    "jsdom": "30.1.1",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "sonner": "catalog:",
    "streamdown": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}
